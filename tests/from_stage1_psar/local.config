// Single-host settings for the example run (no SLURM).
process {
    withLabel: 'SN_nf_pulsar|SN_nf_combine_psar|SN_nf_dia_search|SN_nf_combine_sne' {
        // nextflow.config sets SLURM partitions as fallbacks; a local run has none.
        queue = null
    }
    // Thermo's RawFileReader on Linux cannot read .raw files through symlinks, so stage inputs as hard
    // links. The work directory must then be on the same filesystem as rawfile_dir.
    stageInMode = 'link'
}
dag.file = "${launchDir}/logs/flowchart.html"
