// Settings for tests/demo_liver/run_test.sh: one host, no SLURM.
process {
	executor = 'local'
	withLabel: 'SN_nf_pulsar|SN_nf_combine_psar|SN_nf_dia_search|SN_nf_combine_sne' {
		queue = null
	}
	// Thermo's RawFileReader cannot read .raw files through symlinks, so stage inputs as hard links.
	stageInMode = 'link'
}

// The checks in run_test.sh read the task name, status and work folder of every task.
trace.fields = 'task_id,name,status,exit,duration,workdir'

// Graphviz may not be installed.
dag.file = "${params.log_dir}/flowchart.html"
