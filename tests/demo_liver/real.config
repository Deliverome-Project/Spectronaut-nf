// Real run on the two demo liver raw files. Two per-file tasks run at once on a 64-CPU host;
// lower these for a smaller machine. A failed task (e.g. a licence session still in use) is retried
// after 1 minute, twice.
process {
	withLabel: 'SN_nf_pulsar|SN_nf_dia_search' {
		cpus = 32
		memory = '200 GB'
		time = '24h'
	}
	withLabel: 'SN_nf_combine_psar|SN_nf_combine_sne' {
		cpus = 64
		memory = '400 GB'
		time = '24h'
	}
	withLabel: 'SN_nf_pulsar|SN_nf_combine_psar|SN_nf_dia_search|SN_nf_combine_sne' {
		errorStrategy = { sleep(60000); 'retry' }
		maxRetries = 2
	}
}
executor.queueSize = 2
